<Window x:Class="DupeFinder.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Dupe Finder">
 <Grid x:Name="Root" Padding="28" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,24">
   <StackPanel Spacing="4"><TextBlock Text="DUPE FINDER" FontSize="12" CharacterSpacing="180" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock x:Name="Heading" Text="A little less clutter." FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="Subtitle" Text="Find identical files. Keep what matters." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
   <Button x:Name="ChangeFolder" Content="Change folder" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" Click="ChangeFolder_Click"/>
  </Grid>
  <StackPanel x:Name="Setup" Grid.Row="1" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="22">
   <FontIcon Glyph="&#xE8B7;" FontSize="48" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Left"/>
   <TextBlock Text="Where should we look?" FontSize="24" FontWeight="SemiBold"/>
   <TextBlock Text="Choose a folder on this device. Files are compared by their contents using SHA-256, never just their names." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
   <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="FolderPath" Header="Selected folder" IsReadOnly="True" PlaceholderText="Choose a folder…"/><Button Grid.Column="1" Content="Browse…" VerticalAlignment="Bottom" Click="Browse_Click"/></Grid>
   <ToggleSwitch x:Name="Permanent" Header="Delete permanently" OffContent="Off · move files to the Recycle Bin" OnContent="On · files cannot be restored"/>
   <ToggleSwitch x:Name="Remember" Header="Remember settings" OffContent="Off · do not save preferences" OnContent="On · save this folder and preferences locally"/>
   <Button x:Name="OpenButton" Content="OK — open folder" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="Open_Click"/>
  </StackPanel>
  <Grid x:Name="Workspace" Grid.Row="1" Visibility="Collapsed" ColumnSpacing="24">
   <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="260"/><ColumnDefinition Width="3*" MinWidth="360"/></Grid.ColumnDefinitions>
   <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><TextBlock Text="YOUR FILES" FontSize="12" CharacterSpacing="100" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button x:Name="ScanButton" Content="Scan" Style="{StaticResource AccentButtonStyle}" Click="Scan_Click"/><Button x:Name="CancelButton" Content="Cancel" Visibility="Collapsed" Click="Cancel_Click"/></StackPanel></Grid>
    <Border Grid.Row="1" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><TreeView x:Name="FileTree" SelectionMode="None" Expanding="Tree_Expanding"/></Border>
   </Grid>
   <Grid Grid.Column="1" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><TextBlock Text="DUPLICATES" FontSize="12" CharacterSpacing="100"/><TextBlock x:Name="ResultCount" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Results" Spacing="14" Padding="0,0,8,16"/></ScrollViewer>
   </Grid>
  </Grid>
  <StackPanel Grid.Row="2" Spacing="10" Margin="0,18,0,0">
   <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True"/>
   <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ProgressRing x:Name="Busy" Width="18" Height="18" IsActive="False" Visibility="Collapsed"/><TextBlock x:Name="Status" Grid.Column="1" Text="Local files. Local processing. No uploads." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="ModeLabel" Grid.Column="2" Text="COLUMBIA CLOUDWORKS" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/></Grid>
  </StackPanel>
 </Grid>
</Window>
